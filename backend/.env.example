# --- App ---
APP_NAME=APIMarket
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-apimarket-secret-key

# --- Database (Neon Postgres, async driver) ---
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxxx.neon.tech/apimarket?ssl=require

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Algorand network ---
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=
ALGORAND_NETWORK=testnet
USDC_TESTNET_ASA_ID=10458941

# --- x402 protocol ---
X402_QUOTE_SECRET=change-me-to-a-long-random-value
X402_QUOTE_TTL_SECONDS=120

# --- Platform escrow wallet -------------------------------------------------
# Create a dedicated Algorand Testnet account for the PLATFORM (not any
# provider, not any agent). Fund it (https://bank.testnet.algorand.network/)
# and opt it into the USDC testnet ASA before accepting payments in that asset.
# ESCROW_WALLET_ADDRESS must match the address derived from ESCROW_WALLET_MNEMONIC
# (the app checks this at startup and logs a warning if they disagree).
ESCROW_WALLET_ADDRESS=YOUR_PLATFORM_ESCROW_ALGORAND_ADDRESS_58_CHARS
ESCROW_WALLET_MNEMONIC=your 25 word platform escrow wallet mnemonic here
ESCROW_AUTO_RELEASE=true
ESCROW_HOLD_SECONDS=0

# --- Marketplace economics ---
PLATFORM_FEE_BPS=250

# --- Proxy ---
UPSTREAM_TIMEOUT_SECONDS=15.0
