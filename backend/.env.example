# --- App ---
APP_NAME=AgentVault
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret

# --- Database (PostgreSQL / Neon / local) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentvault
DB_ECHO=false

# --- x402 / Algorand (AVM) ---
# Public Coinbase-operated facilitator; works out of the box on testnet.
X402_FACILITATOR_URL=https://x402.org/facilitator
ALGORAND_NETWORK_CAIP2=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
USDC_TESTNET_ASA_ID=10458941

# --- CORS (frontend origins) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Policy defaults ---
DEFAULT_MIN_PROVIDER_REPUTATION=50

# --- Mock provider (demo) ---
# The Algorand address that receives payments for the local demo provider.
MOCK_PROVIDER_PAY_TO=YOUR_ALGORAND_TESTNET_RECEIVE_ADDRESS
